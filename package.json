{
  "name": "@hraness/stripe-history",
  "version": "0.1.0",
  "private": true,
  "description": "Stripe History is an independent record of how Stripe grew. Every event is dated and linked to its sources, and the data downloads as open YAML.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/stripe-history.git"
  },
  "homepage": "https://hraness.com/stripe",
  "bugs": {
    "url": "https://github.com/hraness/stripe-history/issues"
  },
  "keywords": [
    "stripe",
    "stripe-history",
    "company-history",
    "business-history",
    "history",
    "fintech",
    "valuation",
    "payments",
    "timeline",
    "open-data",
    "data-journalism",
    "reference",
    "open-source",
    "nextjs",
    "typescript",
    "bun"
  ],
  "scripts": {
    "build": "bun scripts/build-theme-bootstrap.ts && node scripts/build-next.ts",
    "build:theme": "bun scripts/build-theme-bootstrap.ts",
    "check:cost-surfaces": "bun ./scripts/check-cost-surfaces.mjs",
    "check": "bun run check:cost-surfaces && bun run typecheck && bun run lint && bun run test",
    "dev": "bun scripts/build-theme-bootstrap.ts && node scripts/compiled-preview.ts",
    "test:compiled-preview": "node scripts/compiled-preview-browser.ts",
    "history:sessions:update": "bun run scripts/update-sessions-history.ts",
    "history:research:audit": "bun run scripts/audit-history-research.ts",
    "history:research:discover": "bun run scripts/audit-history-research.ts --discover",
    "history:research:plan": "bun run scripts/audit-history-research.ts --plan",
    "history:news:pull": "bun run scripts/pull-latest-news.ts",
    "history:appearances:summarize": "bun run scripts/summarize-appearance.ts",
    "history:publish:auto": "bun run scripts/auto-publish-history.ts",
    "lint": "eslint .",
    "search:indexnow": "bun run scripts/submit-indexnow.ts",
    "start": "next start",
    "test": "bun test --preload ./scripts/register-stylex-test-transform.ts ./app ./lib ./scripts ./proxy.test.ts",
    "typecheck": "tsc --noEmit",
    "kb:refresh": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell refresh --root kb",
    "kb:check:lane": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell check --root kb --no-catalog",
    "kb:check": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell check --root kb && bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell agents check --root kb --repo .",
    "kb:catalog": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell catalog --root kb",
    "kb:search": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell search --root kb --mode exact --selected-passage",
    "sync:icons": "bun run ./scripts/sync-icons.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway-v4": "npm:@ai-sdk/gateway@^4.0.27",
    "@hraness/design-kit": "github:hraness/design-kit#v0.35.0",
    "@hraness/site-footer": "https://github.com/hraness/site-footer/releases/download/v0.20.5/hraness-site-footer-0.20.5.tgz",
    "@hraness/ui": "github:hraness/ui#v0.5.19",
    "@hraness/vercel-delivery": "github:hraness/vercel-delivery#v0.1.2",
    "@hraness/web-discovery": "github:hraness/web-discovery#v0.13.0",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@stylexjs/stylex": "0.19.0",
    "ai-v7": "npm:ai@^7.0.36",
    "next": "16.3.3",
    "posthog-js": "1.412.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "@hraness/posthog": "https://github.com/hraness/posthog/releases/download/v0.3.9/hraness-posthog-0.3.9.tgz"
  },
  "patchedDependencies": {
    "next@16.3.3": "patches/next@16.3.3.patch"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@stylexjs/babel-plugin": "0.19.0",
    "@types/babel__core": "7.20.5",
    "@types/bun": "1.3.14",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.3",
    "lightningcss": "1.33.0",
    "playwright-core": "1.62.0",
    "typescript": "6.0.3"
  }
}

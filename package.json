{
  "name": "@hraness/stripe-history",
  "version": "0.1.0",
  "private": true,
  "description": "An independent, open-source timeline of Stripe company history, with sourced data on products, acquisitions, funding, valuation, leadership, expansion, milestones, and annual payment volume.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/stripe-history.git"
  },
  "homepage": "https://hraness.com/stripe",
  "bugs": {
    "url": "https://github.com/hraness/stripe-history/issues"
  },
  "keywords": [
    "stripe",
    "stripe-history",
    "company-history",
    "business-history",
    "history",
    "fintech",
    "valuation",
    "payments",
    "timeline",
    "open-data",
    "data-journalism",
    "reference",
    "open-source",
    "nextjs",
    "typescript",
    "bun"
  ],
  "scripts": {
    "build": "next build --webpack",
    "check": "bun run typecheck && bun run lint && bun run test",
    "dev": "next dev --webpack",
    "history:sessions:update": "bun run scripts/update-sessions-history.ts",
    "history:research:audit": "bun run scripts/audit-history-research.ts",
    "history:research:discover": "bun run scripts/audit-history-research.ts --discover",
    "history:research:plan": "bun run scripts/audit-history-research.ts --plan",
    "history:news:pull": "bun run scripts/pull-latest-news.ts",
    "history:appearances:summarize": "bun run scripts/summarize-appearance.ts",
    "history:publish:auto": "bun run scripts/auto-publish-history.ts",
    "lint": "eslint .",
    "search:indexnow": "bun run scripts/submit-indexnow.ts",
    "start": "next start",
    "test": "bun test ./app ./lib ./scripts",
    "typecheck": "tsc --noEmit",
    "kb:refresh": "bunx --bun github:hraness/kb#v0.15.2 refresh --root kb",
    "kb:check:lane": "bunx --bun github:hraness/kb#v0.15.2 check --root kb --no-catalog",
    "kb:check": "bunx --bun github:hraness/kb#v0.15.2 check --root kb && bunx --bun github:hraness/kb#v0.15.2 agents check --root kb --repo .",
    "kb:catalog": "bunx --bun github:hraness/kb#v0.15.2 catalog --root kb"
  },
  "dependencies": {
    "@ai-sdk/gateway-v4": "npm:@ai-sdk/gateway@^4.0.27",
    "@hraness/design-kit": "github:hraness/design-kit#v0.2.1",
    "@hraness/site-footer": "github:hraness/site-footer#v0.4.3",
    "@hraness/ui": "github:hraness/ui#v0.4.10",
    "@hraness/vercel-delivery": "github:hraness/vercel-delivery#v0.1.2",
    "@hraness/web-discovery": "github:hraness/web-discovery#v0.2.0",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "ai-v7": "npm:ai@^7.0.36",
    "next": "16.2.12",
    "posthog-js": "1.412.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.12",
    "typescript": "^6.0.3"
  }
}

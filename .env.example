# Configure these analytics values only for the hraness.com/stripe Production
# surface.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-only source-map uploads. Store POSTHOG_API_KEY as a sensitive Production
# value; it must be scoped to error_tracking:write on this project. Vercel supplies
# VERCEL_ENV and VERCEL_GIT_COMMIT_SHA. Missing values leave uploads disabled.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=543691
POSTHOG_UI_HOST=https://us.posthog.com

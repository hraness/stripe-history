# Public hostname-restricted Cloudflare Turnstile key for the Stripe History
# footer signup. Configure it in Vercel Production and Preview. The matching
# secret, dated consent records, and delivery credentials stay in Accounts.
NEXT_PUBLIC_HRANESS_MAILING_TURNSTILE_SITEKEY=

# Configure these analytics values only for the hraness.com/stripe Production
# surface.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
